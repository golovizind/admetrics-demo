# Скопируйте в .env и заполните.  cp .env.example .env
# Файл .env в git не попадает — он в .gitignore.

# --- Обязательное ----------------------------------------------------------
# Ключ шифрования мультитокенов. Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеряете — все личики придётся переподключать.
ADMETRICS_KEY=

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Ваш Telegram ID через запятую. Узнать: напишите @userinfobot.
# Без него админских команд не будет ни у кого.
ADMIN_TG_IDS=

# --- База ------------------------------------------------------------------
# Не задавайте DATABASE_URL — будет локальный файл admetrics.sqlite3.
# Для Postgres: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# Отдельная схема Postgres, чтобы чужие таблицы в public не мешали.
# ADMETRICS_PG_SCHEMA=admetrics

# --- Отчётность ------------------------------------------------------------
ADMETRICS_BASE_CURRENCY=RUB
ADMETRICS_WINDOW_DAYS=7

# Порог сверки с картами: и процент, и абсолютный минимум.
# Без минимума кабинет с открутом $20 шумел бы на расхождении в доллар.
ADMETRICS_RECON_PCT=5
ADMETRICS_RECON_MIN_ABS=20

# --- Бот -------------------------------------------------------------------
# Как часто крутится фоновой цикл: сбор + рассылка алертов, минут.
BOT_CYCLE_MINUTES=10

# --- Веб (нужен только если поднимаете app.py) ------------------------------
ADMIN_USER=founder
ADMIN_PASS=

# --- Технические аккаунты Telegram (раздел «Telegram» в панели) ------------
# Свои ключи приложения: my.telegram.org → API development tools.
# Без них раздел показывает подсказку, а воркер admetrics-tg ждёт.
TG_API_ID=
TG_API_HASH=
# Чем представляется клиент (необязательно).
# TG_DEVICE_MODEL=Admetrics Server
# TG_SYSTEM_VERSION=Linux
# TG_APP_VERSION=1.0
# TG_LANG_CODE=ru
# Только для локальной отладки там, где Telegram открыт: разрешить без прокси.
# TG_ALLOW_DIRECT=0

# --- Реестр аккаунтов (Google-таблица, CSV-экспорт) -----------------------
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
