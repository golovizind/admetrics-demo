# --- Секреты. Никогда ------------------------------------------------------
# В .env лежат ключ шифрования мультитокенов, токен бота, ключи MyBroCards
# и Keitaro. Попав в историю git, они остаются в ней навсегда — даже если
# файл потом удалить: старые коммиты никуда не деваются.
.env
.env.local
.domain

# --- База. Тоже никогда ----------------------------------------------------
# Внутри зашифрованные мультитокены, прокси и картотека из пяти тысяч
# аккаунтов. Шифрование спасает только пока ключ не рядом, а ключ — в .env.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
backup-*.sqlite3
backups/
*.db

# --- Рабочий мусор ---------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Локальное -------------------------------------------------------------
_to_delete/
_backup-keitaro/
Claude outputs/
.claude/
out/
.webapp_url
.fuse_hidden*

# --- macOS -----------------------------------------------------------------
.DS_Store

# --- Кэш аватарок, создаётся панелью -----------------------------------------
data/
